SERVER_PORT=8080
JWT_SECRET=replace_with_openssl_rand_hex_32
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BASE_URL=
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Admin seeder (SUPER_ADMIN role) - set both to enable auto-creation
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=System
ADMIN_COUNTRY_ISO=PE

# Storage: local (dev: backend serves /media) | vps (nginx serves media) | s3 (external)
STORAGE_DRIVER=local
# Public base URL used to compose media URLs (dev: http://localhost:8080/media, vps: nginx url, s3: cdn url)
MEDIA_URL=http://localhost:8080/media
# Local filesystem folder where files are physically written (used by local/vps drivers)
MEDIA_ROOT=/home/blackshadow/Documents/dev/altv/altv-media
